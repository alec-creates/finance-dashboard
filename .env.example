# Template for local configuration. Never commit real values, and never paste them into chat, issues or screenshots.
# Each variable is introduced by the task that first needs it.
#
# Local files (both gitignored, see ADR-0008):
#   .env.local       development -> Neon project finance-dashboard-dev  (synthetic data only)
#   .env.test.local  automated tests -> Neon project finance-dashboard-test  (may be wiped by tests)
# Production values live only in Vercel project settings. Check local files with: npm run db:check-env

# Phase 1 Task 3 - Neon Postgres
# DATABASE_URL: pooled string (Neon "Connect" with Connection pooling ON; host contains "-pooler"), used at runtime
# DIRECT_URL:   direct string (Connection pooling OFF; no "-pooler"), used by Prisma migrations
# DATABASE_ENV: development | test | production; database tests refuse to run unless it is "test"
DATABASE_URL=
DIRECT_URL=
DATABASE_ENV=

# Phase 1 Task 4 - authentication
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Only this email may sign in; there is no public registration.
ALLOWED_EMAIL=

# Phase 6 - key used to encrypt provider credentials (e.g. Kraken read-only API key) at rest
CREDENTIALS_ENCRYPTION_KEY=
