# Template for local configuration. Copy to .env.local and fill in values there.
# Never commit real values, and never paste them into chat, issues or screenshots.
# Each variable is introduced by the task that first needs it.

# Phase 1 Task 3 - Neon Postgres (pooled URL for the app, direct URL for migrations)
DATABASE_URL=
DIRECT_URL=

# Phase 1 Task 4 - authentication
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Only this email may sign in; there is no public registration.
ALLOWED_EMAIL=

# Phase 6 - key used to encrypt provider credentials (e.g. Kraken read-only API key) at rest
CREDENTIALS_ENCRYPTION_KEY=
