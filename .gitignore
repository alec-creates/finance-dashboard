# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: secrets live only in .env.local / Vercel. Only the template is tracked.
.env*
!.env.example

# Financial data: never commit real exports, statements or database backups.
# Synthetic fixtures under tests/fixtures/ are the only exception.
*.csv
*.ofx
*.qfx
*.qbo
*.xls
*.xlsx
*.dump
*.backup
/data/
/backups/
/private/
/imports/
!tests/fixtures/**/*.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude Code settings
.claude/settings.local.json
